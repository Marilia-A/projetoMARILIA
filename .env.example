# Copie este arquivo para .env (na raiz) e preencha. Nunca envie o .env para o GitHub.

# Obrigatória: texto longo e aleatório
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Banco: sem esta linha usa SQLite em ./marilia.db. Para PostgreSQL, tire o # e ajuste:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/marilia

# Provedor de IA: groq ou gemini
IA_PROVEDOR=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Administrador inicial
ADMIN_EMAIL=
ADMIN_SENHA=

# Usuários de teste com senha conhecida (padrão: false). Use true só no seu computador.
SEED_USUARIOS_TESTE=true
